# Postgres connection string, e.g. from Neon
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require&uselibpqcompat=true
# Redis connection string, e.g. from Upstash
REDIS_URL=rediss://default:password@host:6379
JWT_SECRET=change-me
ADMIN_EMAIL=admin@example.com
# Comma-separated allowed frontend origins, no trailing slash, e.g. https://your-app.vercel.app
CORS_ORIGIN=http://localhost:5173
# Optional: PORT, HOLD_TTL_SECONDS, RATE_LIMIT_PER_MIN, BCRYPT_ROUNDS, SMTP_URL
